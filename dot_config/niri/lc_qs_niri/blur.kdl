// Blur tuning used by lc_qs_niri glass surfaces.
// Kept outside config.kdl so the shell-specific effect is self-contained.
blur {
    passes 1
    offset 4
    noise 0.02
    saturation 1.5
}

// Spotlight supplies a rounded blur region from QML, so the compositor
// effect follows the glass window instead of filling its transparent margins.
layer-rule {
    match namespace="^quickshell:spotlight$"
    background-effect {
        xray false
        noise 0.02
        saturation 1.2
    }
}
