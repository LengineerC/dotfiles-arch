window-rule {
    match app-id=r#"wps$"#
    match app-id="com.danklinux.dms"

    open-floating true
}

window-rule {
    match app-id="XnView"

    open-floating true
    default-column-width { proportion 0.4; }
    default-column-height { proportion 0.4; }
}

window-rule {
    match app-id="com.danklinux.dms" title="系统监视器"
    open-floating true
}

window-rule {
    match app-id="neovide"
    match app-id="code"
    match app-id="firefox"
    match app-id="google-chrome"
    match app-id="yazi"

    open-maximized true
}
