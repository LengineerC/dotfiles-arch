input {
    touchpad {
        tap
        accel-speed 0.2
        scroll-factor 0.3
        three-finger-drag true
        three-finger-drag-mode "native"
        natural-scroll
    }
}
gestures {
    workspace-switch-fingers 4
    workspace-switch-axis "vertical"
    view-scroll-fingers 0
    overview-fingers 0
    swipe-threshold 8
    view-transition-max-speed 5
}
