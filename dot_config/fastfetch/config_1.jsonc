{
  // "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "38;2;91;206;250",
      "2": "38;2;245;169;184",
      "3": "38;2;255;255;255",
      "4": "38;2;245;169;184",
      "5": "38;2;91;206;250"
    }
    // "color": {
    //   "1": "38;2;227;28;27",
    //   "2": "38;2;255;203;45",
    //   "3": "38;2;0;63;144",
    //   "4": "38;2;255;255;255",
    //   "5": "38;2;0;0;0"
    // }
  },
  "display": {
    "separator": ""
  },
  "modules": [
    // ───────────── PC ─────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;91;206;250m╭──────  PC ──────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 CPU       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 MEM       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "display",
      "key": "│ 󰍹 MON       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 DIS       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "battery",
      "key": "│ 󰁹 BAT       ",
      "keyColor": "38;2;91;206;250"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;91;206;250m╰──────────────────╯\u001b[0m"
    },
    "break",
    // ───────────── OS ─────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;245;169;184m╭──────  OS ──────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "│  OS        ",
      "keyColor": "38;2;245;169;184",
      "format": "{3} {12}"
    },
    {
      "type": "kernel",
      "key": "│ 󰖨 KER       ",
      "keyColor": "38;2;245;169;184"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 PAK       ",
      "keyColor": "38;2;245;169;184"
    },
    {
      "type": "title",
      "key": "│ 󰭹 USR       ",
      "keyColor": "38;2;245;169;184",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;245;169;184m╰──────────────────╯\u001b[0m"
    },
    "break",
    // ───────────── WM ─────────────
    {
      "type": "custom",
      "format": "\u001b[38;2;255;255;255m╭──────  WM ──────╮\u001b[0m"
    },
    {
      "type": "wm",
      "key": "│  WM        ",
      "keyColor": "38;2;255;255;255",
      "format": "{1} ({2})",
      "outputColor": "38;2;255;255;255"
    },
    {
      "type": "cursor",
      "key": "│ 󰳽 CUR       ",
      "keyColor": "38;2;255;255;255"
    },
    {
      "type": "de",
      "key": "│ 󰖲 DES       ",
      "keyColor": "38;2;255;255;255"
    },
    {
      "type": "shell",
      "key": "│ 󰞷 SHE       ",
      "keyColor": "38;2;255;255;255"
    },
    {
      "type": "terminal",
      "key": "│  TER       ",
      "keyColor": "38;2;255;255;255"
    },
    {
      "type": "font",
      "key": "│ 󰛖 SFO       ",
      "keyColor": "38;2;255;255;255"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;255;255m╰──────────────────╯\u001b[0m"
    }
  ]
}
