layer.enabled: true
    layer.effect: MultiEffect {
        maskEnabled: true

        maskSource: Rectangle {
            width: moduleScroll.width
            height: moduleScroll.height

            /*
             * 外层有 10px margin，所以内层圆角可以稍小。
             */
            radius: Math.max(
                0,
                Appearance.cornerSize
                    - Appearance.px(10)
            )

            color: "white"
            antialiasing: true
            layer.enabled: true
        }
    }